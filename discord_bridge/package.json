  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "discord.js": "^14.16.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  }
}
